! rotor
Component 1
  Name = rotor
  Master Bodies(3) = 1 2 3
  Calculate Magnetic Force = Logical True
  Calculate Magnetic Torque = Logical True
  Torque Origin(3) = Real 0.0 0.0 0.0
  Torque Axis(3) = Real 0.0 0.0 1.0
End






